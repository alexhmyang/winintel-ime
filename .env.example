# Copy to .env; Node loads this file at startup. No API keys required.
PORT=8787
# Enable only after installing Ollama and running: ollama pull qwen3:0.6b
AI_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
AI_TIMEOUT_MS=650
# File paths default to models/voice. CPU provider and two threads by default.
ASR_MODEL_DIR=models/voice
ASR_THREADS=2
ASR_PROVIDER=cpu
# Optional custom Rime user directory.
# RIME_USER_DIR=C:\Users\you\AppData\Roaming\Rime
